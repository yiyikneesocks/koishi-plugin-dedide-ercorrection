{
  "name": "koishi-plugin-dedide-ercorrection",
  "description": "中文「的/地/得」混用纠错 for Koishi：内置本地 ONNX 模型，无需联网、无需 LLM，@人/表情占位符保留",
  "version": "0.3.0",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "files": [
    "lib",
    "assets"
  ],
  "license": "MIT",
  "keywords": [
    "chatbot",
    "koishi",
    "plugin",
    "chinese",
    "nlp",
    "的地得",
    "correction"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=cjs --target=node20 --external:koishi --external:onnxruntime-web --outfile=lib/index.js"
  },
  "dependencies": {
    "onnxruntime-web": "^1.20.0"
  },
  "peerDependencies": {
    "koishi": "^4.18.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yiyikneesocks/koishi-plugin-dedide-ercorrection.git"
  },
  "homepage": "https://github.com/yiyikneesocks/koishi-plugin-dedide-ercorrection#readme",
  "bugs": {
    "url": "https://github.com/yiyikneesocks/koishi-plugin-dedide-ercorrection/issues"
  }
}
